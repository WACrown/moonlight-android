<?xml version="1.0" encoding="utf-8"?>
<com.limelight.binding.input.advance_setting.SuperPageLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="500dp"
    android:layout_height="match_parent"
    android:tag="500">
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="5dp"
        android:background="@drawable/super_content_box_background">
        <LinearLayout
            android:id="@+id/device_inner_box"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <include layout="@layout/layout_keyboard"/>
        </LinearLayout>

    </HorizontalScrollView>
</com.limelight.binding.input.advance_setting.SuperPageLayout>
